// Description:
//   Tests the wildcard feature on violations.
//

Fact person Identified by String.
Fact species Identified by String.
Fact species-of Identified by person * species.

Duty no-humans
    Holder person1
    Claimant person2
    Derived from (Foreach person1, person2 :
        no-humans(person1, person2)
        When species-of.person == person1 && person1 != person2
    )
    Violated when species-of(person1, "Human").

//#violated not no-humans(*, *).

+person(Amy).
+person(Bob).
+species(Human).
+species(Klingon).
+species(Romulan).
+species-of(Amy, Human).
+species-of(Bob, Klingon).

//#violated no-humans(person(Amy), *).
//#violated no-humans(*, *).
//#violated no-humans(person(Amy), person(Bob)).
