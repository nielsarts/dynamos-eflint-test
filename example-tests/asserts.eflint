Fact person Identified by String.

//#assert !person("Amy").
+person(Amy).
//#assert person("Amy").



Invariant amy-exists-a
    When person(Amy).

//#assert amy-exists-a.



Act amy-exists-b
    Actor person
    Creates amy-exists-b(person(Bob)).

//#assert !amy-exists-b(person("Amy")).
+amy-exists-b(person("Amy")).
//#assert amy-exists-b(person("Amy")).
//#assert !amy-exists-b(person("Bob")).
amy-exists-b(person("Amy")).
//#assert amy-exists-b(person("Bob")).



Duty amy-exists-c
    Holder person1
    Claimant person2
    Violated when Not(person(Amy)).

//#assert !amy-exists-c(person("Amy"), person("Amy")).
+amy-exists-c(person(Amy), person(Amy)).
//#assert amy-exists-c(person("Amy"), person("Amy")).
