// ─────────────────────────────────────────────────────────────────────────────
// Scenario: Alice requests UVA — approved, but archetype set is restricted
// ─────────────────────────────────────────────────────────────────────────────
//
// Alice is permitted at UVA but her relation only allows DataThroughTtp.
// UVA also supports ComputeToData and ReproducableScience at the agreement
// level, but the intersection with Alice's relation yields DataThroughTtp only.
// ComputeToData and ReproducableScience are explicitly confirmed not valid.
//
// To run (keeps the REPL open: `cat` holds stdin after flatten exits):
//
//   ( python3 flatten.py 01_interface_policy.eflint                          \
//                        02_agreement_rules.eflint                           \
//                        agreement_UVA.eflint                                \
//                        scenario_04b_denied_alice_restricted_archetype.eflint \
//       ; cat ) | eflint-repl
// ─────────────────────────────────────────────────────────────────────────────
#require "01_interface_policy.eflint".
#require "02_agreement_rules.eflint".
#require "agreement_UVA.eflint".

// ═══════════════════════════════════════════════════════════════════════════
// Request facts
// ═══════════════════════════════════════════════════════════════════════════
//
// RequestApproval: { user: "Alice", dataProviders: ["UVA"] }
// Alice is permitted at UVA, but only for DataThroughTtp.

+requester(Alice).
+requested-steward(UVA).

// ═══════════════════════════════════════════════════════════════════════════
// Queries
// ═══════════════════════════════════════════════════════════════════════════

Invariant scenario_four_b_permitted_at_uva
  When permitted-at-steward(Alice, UVA).
//#violated !scenario_four_b_permitted_at_uva.

Invariant scenario_four_b_not_compute_to_data
  When Not(valid-archetype(Alice, UVA, ComputeToData)).
//#violated !scenario_four_b_not_compute_to_data.

Invariant scenario_four_b_not_reproducable_science
  When Not(valid-archetype(Alice, UVA, ReproducableScience)).
//#violated !scenario_four_b_not_reproducable_science.

Invariant scenario_four_b_data_through_ttp
  When valid-archetype(Alice, UVA, DataThroughTtp).
//#violated !scenario_four_b_data_through_ttp.
