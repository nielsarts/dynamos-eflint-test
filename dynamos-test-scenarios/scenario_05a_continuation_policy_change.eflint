// ─────────────────────────────────────────────────────────────────────────────
// Scenario: Continuity — Policy change (F3)
// ─────────────────────────────────────────────────────────────────────────────
//
// UCON re-evaluation trigger: the agreement policy changes (VU withdraws
// ComputeToData). An in-flight session that uses ComputeToData at VU must
// be revoked.
//
// To run (keeps the REPL open: `cat` holds stdin after flatten exits):
//
//   ( python3 flatten.py 01_interface_policy.eflint                     \
//                        02_agreement_rules.eflint                      \
//                        agreement_VU.eflint                            \
//                        scenario_05a_continuation_policy_change.eflint \
//       ; cat ) | eflint-repl
// ─────────────────────────────────────────────────────────────────────────────
#require "01_interface_policy.eflint".
#require "02_agreement_rules.eflint".
#require "agreement_VU.eflint".

// ═══════════════════════════════════════════════════════════════════════════
// BASELINE — Establish a session
// ═══════════════════════════════════════════════════════════════════════════
//
// RequestApproval: { user: "Niels", dataProviders: ["VU"] }

+requester(Niels).
+requested-steward(VU).

Invariant scenario_five_a_permitted_request_baseline
  When permitted-request(Niels).
//#violated !scenario_five_a_permitted_request_baseline.

submit-data-request(Niels, VU).

Invariant scenario_five_a_data_request_baseline
  When data-request(Niels, VU).
//#violated !scenario_five_a_data_request_baseline.

Invariant scenario_five_a_continuation_baseline
  When permitted-continuation(Niels, VU, ComputeToData).
//#violated !scenario_five_a_continuation_baseline.


// ═══════════════════════════════════════════════════════════════════════════
// Policy change: VU withdraws ComputeToData
// ═══════════════════════════════════════════════════════════════════════════

-steward-supports-archetype(VU, ComputeToData).
//#violated scenario_five_a_continuation_baseline.

Invariant scenario_five_a_not_valid_archetype_after_withdrawal
  When Not(valid-archetype(Niels, VU, ComputeToData)).
//#violated !scenario_five_a_not_valid_archetype_after_withdrawal.

Invariant scenario_five_a_no_continuation_after_withdrawal
  When Not(permitted-continuation(Niels, VU, ComputeToData)).
//#violated !scenario_five_a_no_continuation_after_withdrawal.

Invariant scenario_five_a_no_compute_to_data
  When Not(valid-archetype(Niels, VU, ComputeToData)).
//#violated !scenario_five_a_no_compute_to_data.

Invariant scenario_five_a_no_data_through_ttp
  When Not(valid-archetype(Niels, VU, DataThroughTtp)).
//#violated !scenario_five_a_no_data_through_ttp.

// Restore.
+steward-supports-archetype(VU, ComputeToData).

Invariant scenario_five_a_continuation_restored
  When permitted-continuation(Niels, VU, ComputeToData).
//#violated !scenario_five_a_continuation_restored.
