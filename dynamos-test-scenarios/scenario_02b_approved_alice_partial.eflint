// ─────────────────────────────────────────────────────────────────────────────
// Scenario: Alice requests VU + UVA — partially approved (UVA only)
// ─────────────────────────────────────────────────────────────────────────────
//
// Alice has a relation at UVA but NOT at VU.
// The request is overall approved because at least one steward (UVA) passes;
// VU ends up in invalid_dataproviders.
//
// To run (keeps the REPL open: `cat` holds stdin after flatten exits):
//
//   ( python3 flatten.py 01_interface_policy.eflint              \
//                        02_agreement_rules.eflint               \
//                        agreement_VU.eflint                     \
//                        agreement_UVA.eflint                    \
//                        scenario_02b_approved_alice_partial.eflint \
//       ; cat ) | eflint-repl
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════════════
// Request facts
// ═══════════════════════════════════════════════════════════════════════════
//
// RequestApproval: { user: "Alice", dataProviders: ["VU", "UVA"] }

+requester("Alice").
+requested-steward("VU").
+requested-steward("UVA").

// ═══════════════════════════════════════════════════════════════════════════
// Queries
// ═══════════════════════════════════════════════════════════════════════════

// Overall: at least one steward (UVA) has a relation, so admissible.
Invariant scenario_two_b_permitted_request
  When permitted-request("Alice").
//#violated !scenario_two_b_permitted_request.

// Per-steward breakdown:
Invariant scenario_two_b_vu_not_permitted
  When Not(permitted-at-steward("Alice", "VU")).
//#violated !scenario_two_b_vu_not_permitted.

Invariant scenario_two_b_uva_permitted
  When permitted-at-steward("Alice", "UVA").
//#violated !scenario_two_b_uva_permitted.

// VU yields nothing:
Invariant scenario_two_b_vu_not_compute_to_data
  When Not(valid-archetype("Alice", "VU", "ComputeToData")).
//#violated !scenario_two_b_vu_not_compute_to_data.

Invariant scenario_two_b_vu_not_data_through_ttp
  When Not(valid-archetype("Alice", "VU", "DataThroughTtp")).
//#violated !scenario_two_b_vu_not_data_through_ttp.

Invariant scenario_two_b_vu_not_reproducable_science
  When Not(valid-archetype("Alice", "VU", "ReproducableScience")).
//#violated !scenario_two_b_vu_not_reproducable_science.

// UVA yields DataThroughTtp:
Invariant scenario_two_b_uva_data_through_ttp
  When valid-archetype("Alice", "UVA", "DataThroughTtp").
//#violated !scenario_two_b_uva_data_through_ttp.

Invariant scenario_two_b_uva_not_compute_to_data
  When Not(valid-archetype("Alice", "UVA", "ComputeToData")).
//#violated !scenario_two_b_uva_not_compute_to_data.

Invariant scenario_two_b_uva_not_reproducable_science
  When Not(valid-archetype("Alice", "UVA", "ReproducableScience")).
//#violated !scenario_two_b_uva_not_reproducable_science.

// Act is not permitted for VU (no relation):
submit-data-request("Alice", "VU").
//#violated submit-data-request(*, *).

submit-data-request("Alice", "UVA").

Invariant scenario_two_b_uva_data_request
  When data-request("Alice", "UVA").
//#violated !scenario_two_b_uva_data_request.
