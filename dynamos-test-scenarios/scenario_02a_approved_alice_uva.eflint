// ─────────────────────────────────────────────────────────────────────────────
// Scenario: Alice requests UVA — approved
// ─────────────────────────────────────────────────────────────────────────────
//
// Alice has a relation at UVA (DataThroughTtp only); no relation at VU.
// This scenario covers a single-steward approved request.
//
// To run (keeps the REPL open: `cat` holds stdin after flatten exits):
//
//   ( python3 flatten.py 01_interface_policy.eflint          \
//                        02_agreement_rules.eflint           \
//                        agreement_UVA.eflint                \
//                        scenario_02a_approved_alice_uva.eflint \
//       ; cat ) | eflint-repl
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════════════
// Request facts
// ═══════════════════════════════════════════════════════════════════════════
//
// RequestApproval: { user: "Alice", dataProviders: ["UVA"] }

+requester("Alice").
+requested-steward("UVA").

// ═══════════════════════════════════════════════════════════════════════════
// Queries
// ═══════════════════════════════════════════════════════════════════════════

Invariant scenario_two_a_permitted_request
  When permitted-request("Alice").
//#violated !scenario_two_a_permitted_request.

Invariant scenario_two_a_permitted_at_uva
  When permitted-at-steward("Alice", "UVA").
//#violated !scenario_two_a_permitted_at_uva.

Invariant scenario_two_a_uva_data_through_ttp
  When valid-archetype("Alice", "UVA", "DataThroughTtp").
//#violated !scenario_two_a_uva_data_through_ttp.

Invariant scenario_two_a_uva_not_compute_to_data
  When Not(valid-archetype("Alice", "UVA", "ComputeToData")).
//#violated !scenario_two_a_uva_not_compute_to_data.

Invariant scenario_two_a_uva_not_reproducable_science
  When Not(valid-archetype("Alice", "UVA", "ReproducableScience")).
//#violated !scenario_two_a_uva_not_reproducable_science.

submit-data-request("Alice", "UVA").

Invariant scenario_two_a_data_request_uva
  When data-request("Alice", "UVA").
//#violated !scenario_two_a_data_request_uva.
