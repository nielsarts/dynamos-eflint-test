// ─────────────────────────────────────────────────────────────────────────────
// Scenario: Continuity — Subject attribute change (F4)
// ─────────────────────────────────────────────────────────────────────────────
//
// UCON re-evaluation trigger: a subject attribute changes (Niels loses his
// relation at VU). An in-flight ComputeToData session at VU must be revoked.
//
// To run (keeps the REPL open: `cat` holds stdin after flatten exits):
//
//   ( python3 flatten.py 01_interface_policy.eflint                      \
//                        02_agreement_rules.eflint                       \
//                        agreement_VU.eflint                             \
//                        scenario_05b_continuation_subject_change.eflint \
//       ; cat ) | eflint-repl
// ─────────────────────────────────────────────────────────────────────────────
#require "01_interface_policy.eflint".
#require "02_agreement_rules.eflint".
#require "agreement_VU.eflint".

// ═══════════════════════════════════════════════════════════════════════════
// BASELINE — Establish a session
// ═══════════════════════════════════════════════════════════════════════════
//
// RequestApproval: { user: "Niels", dataProviders: ["VU"] }

+requester(Niels).
+requested-steward(VU).

Invariant scenario_five_b_permitted_request_baseline
  When permitted-request(Niels).
//#violated !scenario_five_b_permitted_request_baseline.

submit-data-request(Niels, VU).

Invariant scenario_five_b_data_request_baseline
  When data-request(Niels, VU).
//#violated !scenario_five_b_data_request_baseline.

Invariant scenario_five_b_continuation_baseline
  When permitted-continuation(Niels, VU, ComputeToData).
//#violated !scenario_five_b_continuation_baseline.


// ═══════════════════════════════════════════════════════════════════════════
// Subject attribute change: Niels loses his relation at VU
// ═══════════════════════════════════════════════════════════════════════════

-has-relation(Niels, VU).
//#violated scenario_five_b_permitted_request_baseline.
//#violated scenario_five_b_continuation_baseline.

Invariant scenario_five_b_not_permitted_at_vu
  When Not(permitted-at-steward(Niels, VU)).
//#violated !scenario_five_b_not_permitted_at_vu.

Invariant scenario_five_b_no_continuation_after_relation_loss
  When Not(permitted-continuation(Niels, VU, ComputeToData)).
//#violated !scenario_five_b_no_continuation_after_relation_loss.

// Restore.
+has-relation(Niels, VU).
+relation-allows-request-type(Niels, VU, SqlDataRequest).
+relation-allows-dataset(Niels, VU, WageGap).
+relation-allows-archetype(Niels, VU, ComputeToData).
+relation-allows-compute-provider(Niels, VU, SURF).
//#violated scenario_five_b_not_permitted_at_vu.

Invariant scenario_five_b_continuation_restored
  When permitted-continuation(Niels, VU, ComputeToData).
//#violated !scenario_five_b_continuation_restored.
